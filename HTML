    <!-- Admission Process -->
    <section class="admission-info section">
        <div class="section-heading">
            <p class="tagline">START YOUR JOURNEY</p>
            <h2>Admission Process</h2>
        </div>

        <div class="process-container">
            <div class="process-card">
                <span>01</span>
                <h3>Choose a Course</h3>
                <p>Explore programs and select your preferred course.</p>
            </div>

            <div class="process-card">
                <span>02</span>
                <h3>Fill Application</h3>
                <p>Complete the admission application form.</p>
            </div>

            <div class="process-card">
                <span>03</span>
                <h3>Submit Documents</h3>
                <p>Provide the required academic documents.</p>
            </div>

            <div class="process-card">
                <span>04</span>
                <h3>Admission Confirmation</h3>
                <p>Follow the admission process and confirmation steps.</p>
            </div>
        </div>
    </section>

    <!-- Application Form -->
    <section class="admission section" id="admission">
        <div class="admission-content">
            <p class="tagline">ADMISSIONS OPEN</p>
            <h2>Apply For Admission</h2>
            <p>
                Take the first step towards your future.
                Complete the application form below.
            </p>
        </div>

        <form class="admission-form">
            <input type="text" placeholder="Full Name" required>

            <input type="email" placeholder="Email Address" required>

            <input type="tel" placeholder="Phone Number" required>

            <select required>
                <option value="">Select Your Course</option>
                <option>Computer Science</option>
                <option>Engineering</option>
                <option>Business Administration</option>
                <option>Life Sciences</option>
                <option>Design Studies</option>
                <option>Law</option>
            </select>

            <input type="text" placeholder="Previous Qualification" required>

            <button type="submit">Submit Application</button>
        </form>

        <p class="demo-note">
            Academic demo form only. Applications are not submitted or stored.
        </p>
    </section>

